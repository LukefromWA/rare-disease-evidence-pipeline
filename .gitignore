# Deny by default; approve new repository content explicitly.
/*
!/.gitignore
!/README.md

# Reviewed AI-assistance documentation.
!/docs/
/docs/*
!/docs/AI_ASSISTANCE.md

# Reviewed A11 code only; all other new workflow content stays ignored.
!/workflow/
/workflow/*
!/workflow/scripts/
/workflow/scripts/*
!/workflow/scripts/make_a11_input.R
!/workflow/scripts/run_a11.R
!/workflow/scripts/attach_a11_multimodel.R

# Reviewed citation documentation and path-free version observations only.
!/docs/CITATIONS.md
!/environment/
/environment/*
!/environment/software_versions.observed.tsv

# Reviewed candidate-scoped A1 source, tests, configuration and documentation.
!/workflow/scripts/a0_prepare_candidates.sh
!/docs/candidate-scoped-a1.md

!/tests/
/tests/*
!/tests/test_candidate_subset.py

!/config/
/config/*
!/config/a1.candidates.example.yaml

# Reviewed native-resource staging adapter.
!/workflow/scripts/e04_stage_resource.R

# Reviewed fresh frozen-Stan workflow module.
!/workflow/rules/
/workflow/rules/*
!/workflow/rules/c_stan_fresh.smk

# Reviewed gene-key partition helper.
!/workflow/scripts/a10_partition_gene_keys.py
