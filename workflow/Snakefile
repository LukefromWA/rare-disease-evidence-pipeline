# workflow/Snakefile -- DAG only; all scientific logic lives in workflow/lib and workflow/scripts.
# Run from anywhere:  MVA_ROOT=<project root> MVA_CONFIG=<abs config.yaml> snakemake -s workflow/Snakefile --directory $MVA_ROOT --cores 4
import os, csv, yaml
from snakemake.utils import update_config

CFG = os.path.abspath(os.environ.get("MVA_CONFIG", "config/config.yaml"))
configfile: CFG
_priv = os.path.join(os.path.dirname(CFG), "config.private.yaml")
if os.path.basename(CFG) == "config.yaml" and os.path.exists(_priv):                     # private overlay (gitignored); toy configs are self-contained
    update_config(config, yaml.safe_load(open(_priv)) or {})
SCRIPTS = os.path.join(workflow.basedir, "scripts")
ROOT = os.path.abspath(os.environ.get("MVA_ROOT", "."))
workdir: ROOT
_sf = config["samples_file"] if os.path.isabs(config["samples_file"]) else os.path.join(ROOT, config["samples_file"])
SAMPLES = [r["sample_id"] for r in csv.DictReader(open(_sf), delimiter="\t")]
OUT = config["run"]["output_root"]; EXT = config["run"]["external_root"]; RES = config["track2"]["root"]; REG = config["track2"]["registry"]
RSCRIPT = "Rscript --vanilla"

include: "rules/a_private.smk"
# B module excluded: reuse existing external artifacts only.
include: "rules/c_frozen_inference.smk"
include: "rules/e_track2_resources.smk"
include: "rules/d_track2.smk"
if config.get("frozen_stan", {}).get("enabled") is True:
    include: "rules/c_stan_fresh.smk"
include: "rules/f_report.smk"

rule all:
    default_target: True
    input:
        RES + "/.ready",
        expand(OUT + "/{sample}/a10/ranked_candidates.tsv.gz", sample=SAMPLES),
        expand((OUT + ("/{sample}/c4_stan_union/current_Stan_final_hypothesis_set.tsv" if config.get("frozen_stan", {}).get("enabled") is True else "/{sample}/c4/final_hypothesis_set.tsv.gz")), sample=SAMPLES),
        expand(OUT + "/{sample}/d7/final_report.tsv", sample=SAMPLES),

rule layer_a:
    input: expand(OUT + "/{sample}/a10/ranked_candidates.tsv.gz", sample=SAMPLES)
rule layer_b:
    input: EXT + "/b14/frozen_M2.rds"
rule layer_c:
    input: expand((OUT + ("/{sample}/c4_stan_union/current_Stan_final_hypothesis_set.tsv" if config.get("frozen_stan", {}).get("enabled") is True else "/{sample}/c4/final_hypothesis_set.tsv.gz")), sample=SAMPLES)
rule layer_d:
    input: expand(OUT + "/{sample}/d7/final_report.tsv", sample=SAMPLES)

# Track 1 scoring and A11; the historical union is a separate Track 2 handoff.
rule track1:
    input:
        rules.layer_a.input,
        expand(
            OUT + "/{sample}/c3_stan_cv/stan_cv_predictions.rds",
            sample=SAMPLES
        ) if config.get("frozen_stan", {}).get("enabled") is True else rules.layer_c.input,
        expand(
            OUT + "/{sample}/c3_stan_cv/stan_cv_predictions_summary.tsv",
            sample=SAMPLES
        ) if config.get("frozen_stan", {}).get("enabled") is True else [],
        expand(
            OUT + "/{sample}/a11_review/calculation/bayesian_dependence_sensitivity_ensemble_consensus.csv",
            sample=SAMPLES
        ) if config.get("frozen_stan", {}).get("enabled") is True else []

# BEGIN full_extended_completion_v1
_FULL_EXTENDED_ARTIFACTS = ['a10/ranked_candidates.tsv.gz', 'c4_stan_union/current_Stan_final_hypothesis_set.tsv', 'd7/final_report.tsv', 'd3/codon_context/codon_context.tsv', 'd3/codon_context/flanking_context.fasta', 'd3/codon_context/manifest.json', 'd3/codon_context/genomic_mapping/codon_genomic_mapping.tsv', 'd3/codon_context/genomic_mapping/stop_codon_lookup.bed', 'd3/codon_context/genomic_mapping/manifest.json', 'd3/readthrough_route/routing.tsv', 'd3/readthrough_route/manifest.json', 'd3/readthrough_route_multiview/routing.tsv', 'd3/readthrough_route_multiview/selection_witnesses.tsv', 'd3/readthrough_route_multiview/view_coverage.tsv', 'd3/readthrough_route_multiview/manifest.json', 'd3/readthrough_context_bridge/verification.tsv', 'd3/readthrough_context_bridge/context_requests.tsv', 'd3/readthrough_context_bridge/manifest.json', 'd3/rtdetective_adoption/predictions.tsv', 'd3/rtdetective_adoption/adoption_status.tsv', 'd3/rtdetective_adoption/manifest.json', 'd3/rtdetective_lookup/DAP_tga/lookup_status.tsv', 'd3/rtdetective_lookup/DAP_tga/exact_matches.tsv', 'd3/rtdetective_lookup/DAP_tga/manifest.json', 'd3/rtdetective_lookup/Clitocine_tga/lookup_status.tsv', 'd3/rtdetective_lookup/Clitocine_tga/exact_matches.tsv', 'd3/rtdetective_lookup/Clitocine_tga/manifest.json', 'd3/rtdetective_lookup/SRI_tga/lookup_status.tsv', 'd3/rtdetective_lookup/SRI_tga/exact_matches.tsv', 'd3/rtdetective_lookup/SRI_tga/manifest.json', 'd3/claim_ledger/sources.tsv', 'd3/claim_ledger/claims.tsv', 'd3/claim_ledger/claim_hypothesis_links.tsv', 'd3/claim_ledger/review_queue.tsv', 'd3/claim_ledger/used_references.ris', 'd3/claim_ledger/manifest.json', 'd3/claim_ledger_mechanistic/sources.tsv', 'd3/claim_ledger_mechanistic/source_snapshots.tsv', 'd3/claim_ledger_mechanistic/claims.tsv', 'd3/claim_ledger_mechanistic/claim_hypothesis_links.tsv', 'd3/claim_ledger_mechanistic/claim_source_links.tsv', 'd3/claim_ledger_mechanistic/review_queue.tsv', 'd3/claim_ledger_mechanistic/source_review_queue.tsv', 'd3/claim_ledger_mechanistic/used_references.ris', 'd3/claim_ledger_mechanistic/manifest.json']

rule audit_full_extended:
    input:
        artifacts=lambda wc: [OUT + "/" + wc.sample + "/" + name for name in _FULL_EXTENDED_ARTIFACTS],
        ready=RES + "/.ready",
        code=SCRIPTS + "/audit_full_extended.py"
    output:
        audit=OUT + "/{sample}/extended/run_audit.json"
    params:
        case=lambda wc: OUT + "/" + wc.sample
    log: OUT + "/{sample}/logs/full_extended_audit.log"
    shell:
        r"""
        mkdir -p $(dirname {log:q})
        python3 -B {input.code:q} --case-dir {params.case:q} --out {output.audit:q} > {log:q} 2>&1
        """

rule full_extended:
    input:
        rules.all.input,
        expand(OUT + "/{sample}/extended/run_audit.json", sample=SAMPLES)
# END full_extended_completion_v1
